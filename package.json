    "test:gmail-oauth": "NODE_ENV=test tsx tests/test_gmail_oauth.ts",
    "test:cart-ollama": "NODE_ENV=test tsx tests/test_cart_campaign_ollama.ts",
    "test": "npm run test:format-reason && npm run test:normalize-url && npm run test:gmail-oauth && npm run test:cart-ollama && npm run test:exclusions && npm run test:filter && npm run test:cross && npm run test:one-click && npm run test:cart && npm run test:safety && npm run test:launch-error && npm run test:resubmit && npm run test:trial && npm run test:cv-base && npm run test:e2e && npm run test:concurrency && npm run test:pipeline && npm run test:dom && NODE_ENV=test tsx tests/test_auth.ts"
  },
  "dependencies": {
