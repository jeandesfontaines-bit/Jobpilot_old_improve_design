    "test:filter": "NODE_ENV=test tsx tests/test_job_filter_engine.ts",
    "test:cv-base": "NODE_ENV=test tsx tests/test_cv_base_mutation.ts",
    "test:e2e": "NODE_ENV=test tsx tests/test_e2e_application_chain.ts",
    "test:pipeline": "NODE_ENV=test tsx tests/test_autonomous_pipeline.ts",
    "test:dom": "NODE_ENV=test tsx tests/test_dom_cleaner.ts",
    "test:cross": "NODE_ENV=test tsx tests/test_feature1_cross_exclusion.ts",
    "test:one-click": "NODE_ENV=test tsx tests/test_feature2_one_click_apply.ts",
    "test:cart": "NODE_ENV=test tsx tests/test_feature3_cart.ts",
    "test:safety": "NODE_ENV=test tsx tests/test_safety_guards.ts",
